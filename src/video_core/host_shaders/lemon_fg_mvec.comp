// Per-pixel motion vectors from the block motion search: for each pixel of the current frame C,
// the offset in output pixels to where it was in the previous frame A. The flow u (A(x) ~
// C(x + u)) is anchored on A, so the offset d = u(x - d) is solved by fixed-point iteration.

#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler linear_sampler;
layout(set = 0, binding = 1) uniform texture2D flow;
layout(set = 0, binding = 2, rg16f) uniform writeonly image2D motion;

layout(push_constant) uniform PushConstants {
    ivec2 size;
    ivec2 grid;
    vec2 search_scale;
};

const float BLOCK = 8.0;
const int ITERATIONS = 4;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const vec2 position = (vec2(pixel) + 0.5) / search_scale;
    vec2 d = vec2(0.0);
    for (int i = 0; i < ITERATIONS; ++i) {
        const vec2 uv = (position - d) / BLOCK / vec2(grid);
        d = textureLod(sampler2D(flow, linear_sampler), uv, 0.0).xy;
    }
    imageStore(motion, pixel, vec4(-d * search_scale, 0.0, 0.0));
}
