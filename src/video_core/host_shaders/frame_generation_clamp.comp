// Keeps a generated frame made of what the two real frames around it show. Frame generation here
// has no depth or motion from the game, so it follows the optical flow of the finished pictures
// alone, and where that fails (flat UI over a moving background, saturated icons and labels) it
// fills the gap from far away: soft patches of red and green that are in neither real frame, and
// that blink on every second frame. A generated pixel may only take colors that the previous or
// the current frame has within a few pixels of it. Real motion of a few pixels is left alone,
// and a color that nothing nearby has is pulled back to the closest one that something does.

#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D current_frame;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D previous_frame;
layout(set = 0, binding = 2, rgba8) uniform image2D generated_frame;

layout(push_constant) uniform PushConstants {
    ivec2 size;
};

const int RADIUS = 4;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec3 lowest = vec3(1.0);
    vec3 highest = vec3(0.0);
    for (int y = -RADIUS; y <= RADIUS; ++y) {
        for (int x = -RADIUS; x <= RADIUS; ++x) {
            const ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            const vec3 current = imageLoad(current_frame, at).rgb;
            const vec3 earlier = imageLoad(previous_frame, at).rgb;
            lowest = min(lowest, min(current, earlier));
            highest = max(highest, max(current, earlier));
        }
    }
    const vec4 value = imageLoad(generated_frame, pixel);
    imageStore(generated_frame, pixel, vec4(clamp(value.rgb, lowest, highest), value.a));
}
