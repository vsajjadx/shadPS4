// Copies the game's scene depth into DLSS5's depth input at the size of the presented frame.

#version 460 core
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D scene_depth;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D depth;

layout(push_constant) uniform PushConstants {
    ivec2 size;
    ivec2 source_size;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const ivec2 source =
        min(ivec2((vec2(pixel) + 0.5) * vec2(source_size) / vec2(size)), source_size - 1);
    imageStore(depth, pixel, vec4(texelFetch(scene_depth, source, 0).r));
}
