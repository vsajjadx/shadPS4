// Keeps DLSS5 to light and shading. A pixel may not get brighter than the brightest pixel around
// it in the original picture, nor more than a quarter brighter than itself: brightening that spills
// past an edge shows as a glow, and on a scene still in linear HDR the game's bloom grows it into a
// white haze. Its hue may only move a little, so the network can't paint patches of false color.

#version 460 core
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D original;
layout(set = 0, binding = 1, rgba16f) uniform image2D result;

layout(push_constant) uniform PushConstants {
    ivec2 size;
};

const float MAX_GAIN = 1.25;
const float MIN_HEADROOM = 0.02;
const float MAX_TINT = 0.08;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    float brightest = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const ivec2 at = clamp(pixel + ivec2(x, y), ivec2(0), size - 1);
            brightest = max(brightest, dot(texelFetch(original, at, 0).rgb, LUMA));
        }
    }
    const vec3 own = texelFetch(original, pixel, 0).rgb;
    const vec4 value = imageLoad(result, pixel);
    const float own_luma = dot(own, LUMA);
    const float new_luma = dot(value.rgb, LUMA);
    const float luma =
        min(new_luma, min(brightest, own_luma * MAX_GAIN + MIN_HEADROOM));
    const vec3 own_tint = own / max(own_luma, 1e-4);
    const vec3 new_tint = value.rgb / max(new_luma, 1e-4);
    const vec3 tint = own_tint + clamp(new_tint - own_tint, -MAX_TINT, MAX_TINT);
    imageStore(result, pixel, vec4(max(tint * luma, vec3(0.0)), value.a));
}
