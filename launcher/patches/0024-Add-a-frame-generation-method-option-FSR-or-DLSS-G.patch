From 6cea9e90805d512ca582f3635c48f44cf2c332e9 Mon Sep 17 00:00:00 2001
From: vsajjadx <noreply@users.noreply.github.com>
Date: Thu, 5 Nov 2026 08:49:19 +0000
Subject: [PATCH] Add a frame generation method option (FSR or DLSS-G) to the
 Graphics tab

---
 src/core/emulator_settings.h   |  5 +++++
 src/qt_gui/settings_dialog.cpp | 18 +++++++++++++++++-
 src/qt_gui/settings_dialog.h   |  1 +
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/src/core/emulator_settings.h b/src/core/emulator_settings.h
index f3b1fe7..b66d255 100644
--- a/src/core/emulator_settings.h
+++ b/src/core/emulator_settings.h
@@ -433,6 +433,7 @@ struct GPUSettings {
     Setting<bool> userfaultfd{false};
     Setting<bool> inline_fetch_shader{false};
     Setting<bool> frame_generation_enabled{false};
+    Setting<std::string> frame_generation_backend{"FSR"};
     Setting<bool> anti_aliasing{false};
     Setting<u32> resolution_scale{100};
     Setting<u32> anisotropic_filtering{0};
@@ -464,6 +465,8 @@ struct GPUSettings {
             make_override<GPUSettings>("inline_fetch_shader", &GPUSettings::inline_fetch_shader),
             make_override<GPUSettings>("frame_generation_enabled",
                                        &GPUSettings::frame_generation_enabled),
+            make_override<GPUSettings>("frame_generation_backend",
+                                       &GPUSettings::frame_generation_backend),
             make_override<GPUSettings>("anti_aliasing", &GPUSettings::anti_aliasing),
             make_override<GPUSettings>("resolution_scale", &GPUSettings::resolution_scale),
             make_override<GPUSettings>("anisotropic_filtering",
@@ -480,6 +483,7 @@ NLOHMANN_DEFINE_TYPE_NON_INTRUSIVE(GPUSettings, window_width, window_height, int
                                    vblank_frequency, full_screen, full_screen_mode, present_mode,
                                    hdr_allowed, fsr_enabled, rcas_enabled, rcas_attenuation,
                                    userfaultfd, inline_fetch_shader, frame_generation_enabled,
+                                   frame_generation_backend,
                                    anti_aliasing, resolution_scale, anisotropic_filtering,
                                    brightness, contrast)
 
@@ -761,6 +765,7 @@ public:
     SETTING_FORWARD_BOOL(m_gpu, UserfaultfdTracking, userfaultfd)
     SETTING_FORWARD_BOOL_READONLY(m_gpu, InlineFetchShader, inline_fetch_shader)
     SETTING_FORWARD_BOOL(m_gpu, FrameGenerationEnabled, frame_generation_enabled)
+    SETTING_FORWARD(m_gpu, FrameGenerationBackend, frame_generation_backend)
     SETTING_FORWARD_BOOL(m_gpu, AntiAliasing, anti_aliasing)
     SETTING_FORWARD(m_gpu, ResolutionScale, resolution_scale)
     SETTING_FORWARD(m_gpu, AnisotropicFiltering, anisotropic_filtering)
diff --git a/src/qt_gui/settings_dialog.cpp b/src/qt_gui/settings_dialog.cpp
index adb7f9d..469a107 100644
--- a/src/qt_gui/settings_dialog.cpp
+++ b/src/qt_gui/settings_dialog.cpp
@@ -575,6 +575,7 @@ SettingsDialog::SettingsDialog(std::shared_ptr<gui_settings> gui_settings,
         ui->graphicsAdapterGroupBox->installEventFilter(this);
         ui->windowSizeGroupBox->installEventFilter(this);
         frameGenCheckBox->installEventFilter(this);
+        frameGenBackendComboBox->installEventFilter(this);
         antiAliasingCheckBox->installEventFilter(this);
         resolutionScaleComboBox->installEventFilter(this);
         anisotropicComboBox->installEventFilter(this);
@@ -794,6 +795,11 @@ void SettingsDialog::LoadValuesFromConfig() {
     ui->enableHDRCheckBox->setChecked(EmulatorSettings.IsHdrAllowed());
     SyncResolutionComboBox();
     frameGenCheckBox->setChecked(EmulatorSettings.IsFrameGenerationEnabled());
+    {
+        const int backendIndex = frameGenBackendComboBox->findData(
+            QString::fromStdString(EmulatorSettings.GetFrameGenerationBackend()));
+        frameGenBackendComboBox->setCurrentIndex(backendIndex >= 0 ? backendIndex : 0);
+    }
     LoadDlss5Settings();
     antiAliasingCheckBox->setChecked(EmulatorSettings.IsAntiAliasing());
     SyncImageQualityComboBoxes();
@@ -1066,6 +1072,8 @@ void SettingsDialog::updateNoteTextEdit(const QString& elementName) {
         text = tr("Contrast:\\nMakes the difference between dark and bright tones larger or smaller. 100% shows the image as the game draws it. Higher values make the picture punchier, lower values flatter. It can also be changed while playing from the game window's title bar menu.");
     } else if (elementName == "anisotropicComboBox") {
         text = tr("Anisotropic Filtering:\\nMakes textures sharper on surfaces seen at a steep angle, such as roads and floors. Higher values look better and cost a little GPU time. Off leaves it as the game sets it.");
+    } else if (elementName == "frameGenBackendComboBox") {
+        text = tr("Frame Generation Method:\\nFSR 3.1 works on any GPU. DLSS-G uses NVIDIA Streamline and needs the Streamline DLLs next to the emulator (and an RTX 30 unlock mod on RTX 30 cards); it is experimental and the emulator reports in its log whether it could be enabled. The in-game key that turns frame generation on and off is set in Hotkeys.");
     } else if (elementName == "frameGenCheckBox") {
         text = tr("Enable Frame Generation:\\nAdds a generated frame between every two game frames with AMD FSR 3.1, so the game looks smoother.\\nWorks best when the game already runs at 30 FPS or more. The key that turns it on and off while playing is set in Hotkeys (default: 1).");
     } else if (elementName == "heightDivider") {
@@ -1231,6 +1239,8 @@ void SettingsDialog::UpdateSettings(bool is_specific) {
     EmulatorSettings.SetHdrAllowed(ui->enableHDRCheckBox->isChecked(), is_specific);
     EmulatorSettings.SetFsrEnabled(ui->FSRCheckBox->isChecked(), is_specific);
     EmulatorSettings.SetFrameGenerationEnabled(frameGenCheckBox->isChecked(), is_specific);
+    EmulatorSettings.SetFrameGenerationBackend(
+        frameGenBackendComboBox->currentData().toString().toStdString(), is_specific);
     SaveDlss5Settings();
     EmulatorSettings.SetAntiAliasing(antiAliasingCheckBox->isChecked(), is_specific);
     EmulatorSettings.SetResolutionScale(resolutionScaleComboBox->currentData().toUInt(),
@@ -1646,10 +1656,16 @@ void SettingsDialog::SetupGraphicsExtras() {
             });
 
     // Frame generation; its in-game toggle key is set in the Hotkeys dialog.
-    frameGenCheckBox = new QCheckBox(tr("Enable Frame Generation (NeuralScreen)"), ui->FSRGroupBox);
+    frameGenCheckBox = new QCheckBox(tr("Enable Frame Generation"), ui->FSRGroupBox);
     frameGenCheckBox->setObjectName("frameGenCheckBox");
     ui->verticalLayout_5->insertWidget(0, frameGenCheckBox);
 
+    frameGenBackendComboBox = new QComboBox(ui->FSRGroupBox);
+    frameGenBackendComboBox->setObjectName("frameGenBackendComboBox");
+    frameGenBackendComboBox->addItem(tr("FSR 3.1 (NeuralScreen)"), QStringLiteral("FSR"));
+    frameGenBackendComboBox->addItem(tr("DLSS-G (Streamline)"), QStringLiteral("DLSS-G"));
+    ui->verticalLayout_5->insertWidget(1, frameGenBackendComboBox);
+
     imageQualityGroupBox = new QGroupBox(tr("Image Quality"), this);
     imageQualityGroupBox->setObjectName("imageQualityGroupBox");
     auto* imageQualityLayout = new QVBoxLayout(imageQualityGroupBox);
diff --git a/src/qt_gui/settings_dialog.h b/src/qt_gui/settings_dialog.h
index 8a087e4..0e65c99 100644
--- a/src/qt_gui/settings_dialog.h
+++ b/src/qt_gui/settings_dialog.h
@@ -73,6 +73,7 @@ private:
 
     QComboBox* resolutionComboBox{};
     QCheckBox* frameGenCheckBox{};
+    QComboBox* frameGenBackendComboBox{};
     QCheckBox* antiAliasingCheckBox{};
     QComboBox* resolutionScaleComboBox{};
     QComboBox* anisotropicComboBox{};
-- 
2.43.0

