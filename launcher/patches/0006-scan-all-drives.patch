@@ -0,0 +1,198 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <algorithm>
+#include <cctype>
+#include <mutex>
+#include <string>
+#include <system_error>
+#include <thread>
+
+#include <QStorageInfo>
+
+#include "common/path_util.h"
+#include "game_scanner.h"
+
+#ifdef Q_OS_WIN
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+namespace fs = std::filesystem;
+
+namespace GameScanner {
+
+namespace {
+
+std::string Lower(std::string text) {
+    std::transform(text.begin(), text.end(), text.begin(),
+                   [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return text;
+}
+
+// Folders of the system that never hold a game and are expensive or impossible to read.
+bool IsSystemFolder(const fs::path& folder, const std::string& lower_name, bool at_root) {
+    static constexpr const char* skipped[] = {
+        "$recycle.bin", "system volume information", "$winreagent", "recovery", "windowsapps",
+        "$windows.~bt", "$windows.~ws",
+    };
+    if (std::any_of(std::begin(skipped), std::end(skipped),
+                    [&](const char* name) { return lower_name == name; })) {
+        return true;
+    }
+    std::error_code error;
+    if (lower_name == "windows" && fs::exists(folder / "System32", error)) {
+        return true;
+    }
+#ifndef Q_OS_WIN
+    if (at_root && (lower_name == "proc" || lower_name == "sys" || lower_name == "dev" ||
+                    lower_name == "run")) {
+        return true;
+    }
+#else
+    (void)at_root;
+#endif
+    return false;
+}
+
+bool IsPatchFolder(const std::string& lower_name) {
+    return lower_name.ends_with("-update") || lower_name.ends_with("-patch");
+}
+
+void ScanRoot(const fs::path& root, std::vector<fs::path>& games, std::mutex& games_mutex,
+              std::atomic_int& found, const std::atomic_bool& cancel) {
+    std::vector<fs::path> pending{root};
+    const auto options = fs::directory_options::skip_permission_denied;
+    while (!pending.empty() && !cancel) {
+        const fs::path dir = std::move(pending.back());
+        pending.pop_back();
+
+        std::error_code error;
+        std::vector<fs::path> subfolders;
+        bool has_eboot = false;
+        for (fs::directory_iterator it(dir, options, error), end; !error && it != end;
+             it.increment(error)) {
+            std::error_code entry_error;
+            if (it->is_directory(entry_error)) {
+                if (!entry_error && !it->is_symlink(entry_error)) {
+                    subfolders.push_back(it->path());
+                }
+            } else if (!has_eboot && Lower(it->path().filename().string()) == "eboot.bin") {
+                has_eboot = true;
+            }
+        }
+
+        if (has_eboot && !IsPatchFolder(Lower(dir.filename().string())) &&
+            fs::exists(dir / "sce_sys" / "param.sfo", error)) {
+            {
+                std::scoped_lock lock{games_mutex};
+                games.push_back(dir);
+            }
+            ++found;
+            // Nothing below a game folder is another game.
+            continue;
+        }
+
+        for (auto& subfolder : subfolders) {
+            if (!IsSystemFolder(subfolder, Lower(subfolder.filename().string()), dir == root)) {
+                pending.push_back(std::move(subfolder));
+            }
+        }
+    }
+}
+
+} // namespace
+
+std::vector<fs::path> GetScanRoots() {
+    std::vector<fs::path> roots;
+    for (const QStorageInfo& volume : QStorageInfo::mountedVolumes()) {
+        if (!volume.isValid() || !volume.isReady()) {
+            continue;
+        }
+        const fs::path root = Common::FS::PathFromQString(volume.rootPath());
+#ifdef Q_OS_WIN
+        const std::wstring native = root.wstring();
+        const UINT type = GetDriveTypeW(native.c_str());
+        // Network drives, optical drives and RAM disks are not searched.
+        if (type != DRIVE_FIXED && type != DRIVE_REMOVABLE) {
+            continue;
+        }
+#else
+        const std::string type = volume.fileSystemType().toStdString();
+        if (type == "tmpfs" || type == "proc" || type == "sysfs" || type == "devtmpfs" ||
+            type == "devpts" || type == "cgroup" || type == "cgroup2" || type == "squashfs") {
+            continue;
+        }
+#endif
+        if (std::find(roots.begin(), roots.end(), root) == roots.end()) {
+            roots.push_back(root);
+        }
+    }
+    return roots;
+}
+
+std::vector<fs::path> FindGames(const std::vector<fs::path>& roots, std::atomic_int& found,
+                                const std::atomic_bool& cancel) {
+    std::vector<fs::path> games;
+    std::mutex games_mutex;
+    std::vector<std::thread> threads;
+    threads.reserve(roots.size());
+    for (const fs::path& root : roots) {
+        threads.emplace_back([&] {
+            ScanRoot(root, games, games_mutex, found, cancel);
+        });
+    }
+    for (std::thread& thread : threads) {
+        thread.join();
+    }
+    std::sort(games.begin(), games.end());
+    games.erase(std::unique(games.begin(), games.end()), games.end());
+    return games;
+}
+
+std::vector<fs::path> LibraryFolders(const std::vector<fs::path>& games,
+                                     const std::vector<fs::path>& existing) {
+    const auto is_inside = [](const fs::path& folder, const fs::path& parent) {
+        auto folder_it = folder.begin();
+        for (auto parent_it = parent.begin(); parent_it != parent.end();
+             ++parent_it, ++folder_it) {
+            if (folder_it == folder.end() || *folder_it != *parent_it) {
+                return false;
+            }
+        }
+        return true;
+    };
+
+    // A folder that holds several games is added as it is, so the library keeps one entry for a
+    // collection. A game on its own, or at the top of a drive, is added by itself, because the
+    // library searches everything below the folders it has.
+    std::vector<fs::path> candidates;
+    for (const fs::path& game : games) {
+        const fs::path parent = game.parent_path();
+        const auto in_parent = std::count_if(games.begin(), games.end(), [&](const fs::path& other) {
+            return other.parent_path() == parent;
+        });
+        const bool is_drive_root = parent.empty() || parent == parent.root_path();
+        candidates.push_back(in_parent >= 2 && !is_drive_root ? parent : game);
+    }
+
+    std::vector<fs::path> folders;
+    for (const fs::path& candidate : candidates) {
+        const bool known =
+            std::any_of(existing.begin(), existing.end(),
+                        [&](const fs::path& dir) { return is_inside(candidate, dir); }) ||
+            std::any_of(folders.begin(), folders.end(),
+                        [&](const fs::path& dir) { return is_inside(candidate, dir); });
+        if (!known) {
+            folders.push_back(candidate);
+        }
+    }
+    return folders;
+}
+
+} // namespace GameScanner
