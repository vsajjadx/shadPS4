+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <atomic>
+#include <filesystem>
+#include <vector>
+
+namespace GameScanner {
+
+/// The roots to search: every local and removable drive, or the mounted volumes elsewhere.
+std::vector<std::filesystem::path> GetScanRoots();
+
+/// Looks for PS4 game folders (a folder with eboot.bin and sce_sys/param.sfo) below the given
+/// roots, one thread per root. The Windows folder and the recycle bin are never entered, and a
+/// game folder is not searched any further. Returns the game folders that were found.
+/// `found` counts them while the search runs and `cancel` stops it.
+std::vector<std::filesystem::path> FindGames(const std::vector<std::filesystem::path>& roots,
+                                             std::atomic_int& found,
+                                             const std::atomic_bool& cancel);
+
+/// The folders to add to the game library for the found games, left out when one of the
+/// `existing` folders already contains them.
+std::vector<std::filesystem::path> LibraryFolders(
+    const std::vector<std::filesystem::path>& games,
+    const std::vector<std::filesystem::path>& existing);
+
+} // namespace GameScanner
