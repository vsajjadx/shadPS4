+std::string_view GetEntryNameByType(u32 type) {
+    const auto key = PkgEntryValue{type};
+    const auto it = std::ranges::lower_bound(PkgEntries, key);
+    if (it != PkgEntries.end() && it->type == type) {
+        return it->name;
+    }
+    return "";
