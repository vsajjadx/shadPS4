From c6703aa9c38e6c78587290cfd7f13cc9ec99b008 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 4 Nov 2026 17:11:52 +0000
Subject: [PATCH] Fix PKG::Open losing its place in the entry table after
 reading an asset

Reading param.sfo moved the file pointer, so the entries after it (pic1.png,
icon0.png, snd0.at9) were parsed from the middle of the data and never matched.
Remember the next table entry position and seek back to it after each read.
---
 src/core/file_format/pkg.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/core/file_format/pkg.cpp b/src/core/file_format/pkg.cpp
index 2c90783..95a73e0 100644
--- a/src/core/file_format/pkg.cpp
+++ b/src/core/file_format/pkg.cpp
@@ -84,6 +84,9 @@ bool PKG::Open(const std::filesystem::path& filepath, std::string& failreason) {
         file.Read(entry.offset);
         file.Read(entry.size);
         file.Seek(8, Common::FS::SeekOrigin::CurrentPosition);
+        // Reading an entry's data moves the file pointer, so remember where the next table entry
+        // starts and come back to it, otherwise every entry after param.sfo is read from garbage.
+        const s64 next_entry_pos = file.Tell();
 
         // Try to figure out the name
         const auto name = GetEntryNameByType(entry.id);
@@ -110,6 +113,10 @@ bool PKG::Open(const std::filesystem::path& filepath, std::string& failreason) {
         }
         destination->resize(entry.size);
         file.ReadRaw<u8>(destination->data(), entry.size);
+        if (!file.Seek(next_entry_pos)) {
+            failreason = "Failed to seek back to PKG table entry";
+            return false;
+        }
     }
     file.Close();
 
